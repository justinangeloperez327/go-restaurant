# Copy to .env; never commit actual credentials.
DATABASE_URL=postgres://restaurant:restaurant_dev@localhost:5432/restaurant?sslmode=disable
PORT=8080
API_INTERNAL_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
# Google callback: http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple requires HTTPS redirect and a Services ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=

# Group 5: Only configure Stripe keys server-side (never in NEXT_PUBLIC variables).
# Use a Stripe test-mode account first. Register POST /api/v1/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# COD places an unpaid order; you must collect cash upon delivery.
ALLOW_COD=true
# Merchant-configurable tax and delivery amounts. Defaults intentionally 0 until configured.
TAX_RATE_BPS=0
DELIVERY_FEE_MINOR=0

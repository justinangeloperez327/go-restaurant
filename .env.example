# Copy to .env; never commit actual credentials.
DATABASE_URL=postgres://restaurant:restaurant_dev@localhost:5432/restaurant?sslmode=disable
PORT=8080
API_INTERNAL_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
# Google callback: http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple requires HTTPS redirect and a Services ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=
